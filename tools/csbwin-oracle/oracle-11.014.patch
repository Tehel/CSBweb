+// The oracle (tools/csbwin-oracle/): with CSB_DRAWS=<from>-<to>, in hex, every draw of
+// d.Time <from> to <to> is written to draws.txt with its callers, and TraceLine's lines
+// beside them.
+#include <execinfo.h>
+#include <stdarg.h>
+static int from = -2, to = 0; static FILE *f = NULL;
+static void TraceInit(void) { if (from == -2) { const char *e = getenv("CSB_DRAWS"); from = -1; if (e) { sscanf(e, "%x-%x", &from, &to); f = fopen("draws.txt", "w"); } } }
+void TraceLine(const char *fmt, ...)
+{
+  TraceInit(); if (from < 0 || (i32)d.Time < from || (i32)d.Time > to) return;
+  va_list a; va_start(a, fmt); fprintf(f, "line %x: ", d.Time); vfprintf(f, fmt, a); fprintf(f, "\n"); fflush(f); va_end(a);
+}
+static void TraceDraw(void)
+{
+  static i32 shown = -1; if ((i32)(d.Time >> 10) != shown) { shown = d.Time >> 10; printf("at d.Time %08x\n", d.Time); fflush(stdout); }
+  TraceInit(); if (from < 0 || (i32)d.Time < from || (i32)d.Time > to) return;
+  void *bt[12]; int n = backtrace(bt, 12); char **sym = backtrace_symbols(bt, n);
+  fprintf(f, "draw %x:", d.Time);
+  for (int i = 2; i < n; i++) { const char *a = strchr(sym[i], '('); const char *b = a ? strchr(a, '+') : NULL; if (a && b && b > a + 1) fprintf(f, " < %.*s", (int)(b - a - 1), a + 1); }
+  fprintf(f, "\n"); fflush(f); free(sym);
+}
